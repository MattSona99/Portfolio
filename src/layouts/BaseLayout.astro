---
import { ClientRouter } from "astro:transitions";
import Navbar from "../components/layout/Navbar.astro";
import Loader from "../components/ui/Loader.astro";
import Cursor from "../components/ui/Cursor.astro";
import "../styles/global.css";
const { title = "Matteo Sonaglioni" } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline>
      const apply = (doc) => {
        doc.documentElement.dataset.theme =
          localStorage.getItem("theme") ?? "dark";
        doc.documentElement.lang = localStorage.getItem("lang") ?? "en";
      };
      apply(document);
      document.addEventListener("astro:before-swap", (e) =>
        apply(e.newDocument),
      );
    </script>
    <ClientRouter />
  </head>
  <body class="bg-bg text-fg transition-colors duration-300">
    <!-- Avvolgi il loader in un div nativo per forzare la persistenza del DOM -->
    <div transition:persist="loader-wrapper">
      <Loader />
    </div>
    <Cursor />
    <Navbar />
    <main class="wrap">
      <slot />
    </main>
    <div
      id="scroll-percentage"
      aria-hidden="true"
      class="pointer-events-none fixed top-1/2 right-2 z-50 origin-center -translate-y-1/2 rotate-90 font-bespoke text-sm font-bold tracking-[0.2em] tabular-nums opacity-50 md:right-6 md:text-base"
    >
      000%
    </div>
    <script>
      import "../scripts/theme";
      import "../scripts/lang";
      import "../scripts/lenis";
      import "../scripts/animations/navbar";
      import { initCards } from "../scripts/animations/cards";
      import { initLoader } from "../scripts/animations/loader";
      import { initFooterMotion } from "../scripts/footer-motion";
      import { initCursor } from "../scripts/cursor";

      let cleanupCards: (() => void) | undefined;
      let cleanupFooter: (() => void) | undefined;

      document.addEventListener("astro:page-load", () => {
        const loader = document.getElementById("site-loader");

        if (!sessionStorage.getItem("hasPlayedLoader")) {
          initLoader();
          sessionStorage.setItem("hasPlayedLoader", "true");
        } else if (loader) {
          loader.style.display = "none";
          document.documentElement.style.overflow = "";
        }

        initCursor();

        // Una sola init per pagina, con cleanup della precedente.
        cleanupCards?.();
        cleanupCards = initCards();

        cleanupFooter?.();
        cleanupFooter = initFooterMotion();
      });

      document.addEventListener("astro:before-swap", () => {
        cleanupCards?.();
        cleanupCards = undefined;
        cleanupFooter?.();
        cleanupFooter = undefined;
      });
    </script>
  </body>
</html>