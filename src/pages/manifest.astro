---
import BaseLayout from "../layouts/BaseLayout.astro";
import Box from "../components/ui/Box.astro";
import Footer from "../components/home/Footer.astro";
import SubHeading from "../components/layout/Subheading.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { manifestUi } from "../i18n/manifest.ui";
import { CHAPTERS, LOCALES, DEFAULT_LOCALE, type Locale } from "../contents/manifest.config";
import { references, REFERENCE_GROUPS, REFERENCES_CHECKED } from "../contents/references";
import { AUTHOR, aboutText } from "../contents/author";

// ---------------------------------------------------------------------------
// Data
// ---------------------------------------------------------------------------
type Rendered = Awaited<ReturnType<typeof render>>;
type LangView = {
  entry: CollectionEntry<"manifest">;
  Content: Rendered["Content"];
  fallback: boolean; // true when this language has no translation yet
};

const all = await getCollection("manifest");
const byLang = (l: Locale) =>
  new Map(all.filter((e) => e.id.startsWith(`${l}/`)).map((e) => [e.data.chapter, e] as const));
const maps = Object.fromEntries(LOCALES.map((l) => [l, byLang(l)])) as Record<
  Locale,
  ReturnType<typeof byLang>
>;

// A chapter exists once its default-language (English) file exists.
// Numbers follow the canonical order in CHAPTERS, so "Chapter 05" is always the same chapter.
const chapters = (
  await Promise.all(
    CHAPTERS.map(async (key, i) => {
      const base = maps[DEFAULT_LOCALE].get(key);
      if (!base) return null;
      const views = {} as Record<Locale, LangView>;
      for (const l of LOCALES) {
        const entry = maps[l].get(key) ?? base;
        const { Content } = await render(entry);
        views[l] = { entry, Content, fallback: !maps[l].has(key) };
      }
      return { key, number: String(i + 1).padStart(2, "0"), views };
    }),
  )
).filter((c): c is NonNullable<typeof c> => c !== null);

type Chapter = (typeof chapters)[number];
const byKey = new Map(chapters.map((c) => [c.key as string, c]));

const axioms = (await getCollection("axioms")).sort((a, b) => a.data.order - b.data.order);

const fmt = (d: Date, l: Locale) =>
  d.toLocaleDateString(l === "it" ? "it-IT" : "en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });

const lastUpdated = new Date(
  Math.max(...chapters.map((c) => c.views[DEFAULT_LOCALE].entry.data.updatedAt.getTime())),
);

// Only links to chapters that already exist on the page
const relatedOf = (c: Chapter, lang: Locale) =>
  c.views[lang].entry.data.related.flatMap((k) => {
    const r = byKey.get(k);
    return r ? [{ key: k as string, number: r.number, title: r.views[lang].entry.data.title }] : [];
  });

// Index: the axioms first, then the chapters
const tocItems = [
  { key: "axioms", number: "00", title: (l: Locale) => manifestUi[l].axioms },
  ...chapters.map((c) => ({
    key: c.key as string,
    number: c.number,
    title: (l: Locale) => c.views[l].entry.data.title,
  })),
  { key: "references", number: "REF", title: (l: Locale) => manifestUi[l].references },
  { key: "about", number: "AUT", title: (l: Locale) => manifestUi[l].about },
];

const firstChapterKey = chapters[0]?.key ?? "axioms";
---

<BaseLayout>
  <div data-manifest>
    {/* --- INDEX RAIL: fixed, vertically centred on the left --- */}
    <nav data-toc class="mf-toc" aria-labelledby="mf-toc-title">
      <button
        type="button"
        data-toc-toggle
        class="mf-toc__toggle"
        aria-expanded="false"
        aria-controls="mf-toc-panel"
      >
        <span class="mf-toc__rail" aria-hidden="true"></span>
        <span class="sr-only">
          {LOCALES.map((lang) => (
            <span data-lang={lang} lang={lang}>{manifestUi[lang].toggleIndex}</span>
          ))}
        </span>
        {tocItems.map((item) => <span class="mf-tick" data-tick={item.key} aria-hidden="true" />)}
      </button>

      <div id="mf-toc-panel" class="mf-toc__panel">
        <div class="mf-toc__panel-inner" data-toc-scroll>
          <div class="mb-4 flex items-baseline justify-between font-mono text-[.72rem] uppercase tracking-[.12em]">
            <p id="mf-toc-title">
              {LOCALES.map((lang) => (
                <span data-lang={lang} lang={lang}>{manifestUi[lang].index}</span>
              ))}
            </p>
            <span class="opacity-60"><span data-toc-percent>0</span>%</span>
          </div>

          <ol>
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.key}`} data-toc-link={item.key} class="mf-toc__link">
                  <span class="font-mono text-[.68rem] tracking-[.12em]">{item.number}</span>
                  <span>
                    {LOCALES.map((lang) => (
                      <span data-lang={lang} lang={lang}>{item.title(lang)}</span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <button
            type="button"
            data-toc-top
            class="mt-5 font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60 transition-opacity hover:opacity-100"
          >
            ↑
            {LOCALES.map((lang) => (
              <span data-lang={lang} lang={lang}>{manifestUi[lang].top}</span>
            ))}
          </button>
        </div>
      </div>
    </nav>

    {/* --- HERO --- */}
    <Box
      as="section"
      data-hero
      aria-label="Hero"
      class="-mt-2px relative h-[calc(100svh-var(--header-h))] w-full overflow-hidden"
    >
      <div data-hero-content class="grid h-full w-full grid-cols-1 grid-rows-1">
        {
          LOCALES.map((lang) => {
            const t = manifestUi[lang];
            return (
              <div
                data-lang={lang}
                lang={lang}
                class="col-start-1 row-start-1 flex h-full w-full flex-col justify-between p-6 md:p-12"
              >
                <div class="flex items-center gap-3 font-mono text-[.72rem] uppercase tracking-[.12em]">
                  <span class="inline-block size-2 bg-manifest" aria-hidden="true" />
                  <span>{t.kicker}</span>
                </div>

                <div>
                  <h1
                    data-split
                    data-intro
                    class="font-bespoke text-[clamp(2.75rem,12vw,10rem)] font-extrabold uppercase leading-[.9]"
                  >
                    {t.title}
                  </h1>
                  <p
                    data-split
                    data-intro
                    class="mt-6 max-w-2xl font-mono text-xs uppercase leading-relaxed tracking-[.12em] opacity-75 md:text-sm"
                  >
                    {t.lede}
                  </p>
                </div>

                <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                  <ul class="flex flex-wrap gap-3">
                    <li>
                      <a
                        href="#axioms"
                        class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                      >
                        {t.readPillars}
                      </a>
                    </li>
                    <li>
                      <a
                        href={`#${firstChapterKey}`}
                        class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                      >
                        {t.readChapters}
                      </a>
                    </li>
                    <li>
                      <a
                        href="#about"
                        class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                      >
                        {t.whoWrote}
                      </a>
                    </li>
                  </ul>
                  <p class="font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60 md:text-right">
                    {t.chaptersLabel} {chapters.length}/{CHAPTERS.length} · {t.updatedLabel}{" "}
                    {fmt(lastUpdated, lang)}
                    <span class="mt-1 block">{t.scroll}</span>
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </Box>

    {/* --- THE TEN PILLARS --- */}
    <Box as="section" class="-mt-px relative w-full">
      <div
        id="axioms"
        data-spy="axioms"
        class="grid scroll-mt-[var(--header-h)] gap-8 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-0 md:p-12"
      >
        <div class="self-start md:sticky md:top-[calc(var(--header-h)+2rem)] md:pr-10">
          {
            LOCALES.map((lang) => {
              const t = manifestUi[lang];
              return (
                <div data-lang={lang} lang={lang}>
                  <a
                    href="#axioms"
                    class="font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest hover:underline"
                  >
                    00
                  </a>
                  <h2
                    data-split
                    class="mt-3 font-bespoke text-3xl font-bold uppercase leading-none md:text-4xl"
                  >
                    {t.axioms}
                  </h2>
                  <p class="mt-5 max-w-xs font-mono text-[.72rem] uppercase leading-relaxed tracking-[.12em] opacity-60">
                    {t.axiomsLede}
                  </p>
                </div>
              );
            })
          }
        </div>

        <div class="md:border-l md:border-line md:pl-12 lg:pl-16">
          {
            LOCALES.map((lang) => (
              <div data-lang={lang} lang={lang}>
                {axioms.map((a, i) => (
                  <>
                    {i > 0 && (
                      <div data-line class="h-px w-full origin-left bg-line" aria-hidden="true" />
                    )}
                    <article
                      data-reveal
                      class="grid gap-x-8 gap-y-2 py-6 md:grid-cols-[3rem_minmax(0,1fr)]"
                    >
                      <span class="font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest md:pt-2">
                        {String(a.data.order).padStart(2, "0")}
                      </span>
                      <div>
                        <h3 class="font-bespoke text-2xl font-bold uppercase leading-tight md:text-3xl">
                          {a.data.title[lang] ?? a.data.title.en}
                        </h3>
                        <p data-fade class="mt-3 max-w-3xl text-xl leading-snug md:text-2xl">
                          {a.data.text[lang] ?? a.data.text.en}
                        </p>
                      </div>
                    </article>
                  </>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </Box>

    {/* --- CHAPTERS (the manifest itself) --- */}
    {
      chapters.map((c) => (
        <Box as="section" class="-mt-px relative w-full">
          <div
            id={c.key}
            data-spy={c.key}
            class="grid scroll-mt-[var(--header-h)] gap-8 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-0 md:p-12"
          >
            {/* Sticky chapter label, title and metadata */}
            <div class="self-start md:sticky md:top-[calc(var(--header-h)+2rem)] md:pr-10">
              {LOCALES.map((lang) => {
                const t = manifestUi[lang];
                const v = c.views[lang];
                const d = v.entry.data;
                return (
                  <div data-lang={lang} lang={v.fallback ? DEFAULT_LOCALE : lang}>
                    <a
                      href={`#${c.key}`}
                      class="font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest hover:underline"
                    >
                      {t.chapter} {c.number}
                    </a>
                    <h2
                      data-split
                      class="mt-3 font-bespoke text-3xl font-bold uppercase leading-none md:text-4xl"
                    >
                      {d.title}
                    </h2>
                    <p class="mt-5 font-mono text-[.72rem] uppercase leading-relaxed tracking-[.12em] opacity-60">
                      v{d.version} · {fmt(d.updatedAt, lang)} · {t.status[d.status]}
                    </p>
                    {d.tags.length > 0 && (
                      <ul class="mt-4 flex flex-wrap gap-2">
                        {d.tags.map((tag) => (
                          <li class="box-sm px-2 py-1 font-mono text-[.62rem] uppercase tracking-[.12em] opacity-70">
                            {tag}
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>

            {/* Summary + MDX body */}
            <div class="min-w-0 md:border-l md:border-line md:pl-12 lg:pl-16">
              {LOCALES.map((lang) => {
                const t = manifestUi[lang];
                const v = c.views[lang];
                const { Content } = v;
                const related = relatedOf(c, lang);
                return (
                  <div data-lang={lang} lang={v.fallback ? DEFAULT_LOCALE : lang}>
                    {v.fallback && (
                      <p class="mb-6 font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest">
                        {t.fallbackNote}
                      </p>
                    )}
                    <p data-fade class="max-w-3xl text-2xl leading-snug md:text-3xl">
                      {v.entry.data.summary}
                    </p>

                    <div class="manifest-prose mt-12 max-w-3xl">
                      <Content components={{ h2: SubHeading }} />
                    </div>

                    {related.length > 0 && (
                      <div data-reveal class="mt-14 border-t border-line pt-6">
                        <p class="font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60">
                          {t.related}
                        </p>
                        <ul class="mt-4 flex flex-wrap gap-3">
                          {related.map((r) => (
                            <li>
                              <a
                                href={`#${r.key}`}
                                class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                              >
                                {r.number} · {r.title}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </Box>
      ))
    }

    {/* --- REFERENCES --- */}
    <Box as="section" class="-mt-px relative w-full">
      <div
        id="references"
        data-spy="references"
        class="grid scroll-mt-[var(--header-h)] gap-8 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-0 md:p-12"
      >
        <div class="self-start md:sticky md:top-[calc(var(--header-h)+2rem)] md:pr-10">
          {
            LOCALES.map((lang) => {
              const t = manifestUi[lang];
              return (
                <div data-lang={lang} lang={lang}>
                  <a
                    href="#references"
                    class="font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest hover:underline"
                  >
                    REF
                  </a>
                  <h2
                    data-split
                    class="mt-3 font-bespoke text-3xl font-bold uppercase leading-none md:text-4xl"
                  >
                    {t.references}
                  </h2>
                  <p class="mt-5 max-w-xs font-mono text-[.72rem] uppercase leading-relaxed tracking-[.12em] opacity-60">
                    {t.referencesLede}
                  </p>
                  <p class="mt-4 font-mono text-[.62rem] uppercase tracking-[.12em] opacity-50">
                    {t.linksChecked} {fmt(new Date(REFERENCES_CHECKED), lang)}
                  </p>
                </div>
              );
            })
          }
        </div>

        <div class="min-w-0 md:border-l md:border-line md:pl-12 lg:pl-16">
          {
            LOCALES.map((lang) => {
              const t = manifestUi[lang];
              return (
                <div data-lang={lang} lang={lang}>
                  {REFERENCE_GROUPS.map((group, gi) => {
                    const items = references.filter((r) => r.group === group);
                    return (
                      <section class={gi > 0 ? "mt-12" : ""}>
                        <h3
                          data-reveal
                          class="font-mono text-[.72rem] font-normal uppercase tracking-[.12em] text-manifest"
                        >
                          {t.refGroups[group]}
                        </h3>
                        {items.map((r) => {
                          const cited = r.cited.filter((k) => byKey.has(k));
                          return (
                            <>
                              <div data-line class="mt-6 h-px w-full origin-left bg-line" aria-hidden="true" />
                              <article data-reveal class="py-6">
                                <h4 class="font-bespoke text-xl font-bold leading-tight md:text-2xl">
                                  <a
                                    href={r.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="underline decoration-manifest underline-offset-4 transition-colors hover:text-manifest"
                                  >
                                    {r.title[lang]}
                                    <span aria-hidden="true"> ↗</span>
                                  </a>
                                </h4>
                                <p class="mt-2 font-mono text-[.68rem] uppercase tracking-[.12em] opacity-60">
                                  {r.org} · {r.year}
                                </p>
                                <p class="mt-3 max-w-3xl opacity-80">{r.note[lang]}</p>
                                {cited.length > 0 && (
                                  <p class="mt-4 flex flex-wrap items-center gap-2 font-mono text-[.62rem] uppercase tracking-[.12em]">
                                    <span class="opacity-60">{t.citedIn}</span>
                                    {cited.map((k) => (
                                      <a
                                        href={`#${k}`}
                                        class="box-sm px-2 py-1 transition-colors hover:text-manifest"
                                      >
                                        {byKey.get(k)!.number}
                                      </a>
                                    ))}
                                  </p>
                                )}
                              </article>
                            </>
                          );
                        })}
                      </section>
                    );
                  })}
                </div>
              );
            })
          }
        </div>
      </div>
    </Box>

    {/* --- WHO WROTE THIS --- */}
    <Box as="section" class="-mt-px relative w-full">
      <div
        id="about"
        data-spy="about"
        class="grid scroll-mt-[var(--header-h)] gap-8 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-0 md:p-12"
      >
        <div class="self-start md:sticky md:top-[calc(var(--header-h)+2rem)] md:pr-10">
          {
            LOCALES.map((lang) => {
              const t = manifestUi[lang];
              return (
                <div data-lang={lang} lang={lang}>
                  <a
                    href="#about"
                    class="font-mono text-[.72rem] uppercase tracking-[.12em] text-manifest hover:underline"
                  >
                    AUT
                  </a>
                  <h2
                    data-split
                    class="mt-3 font-bespoke text-3xl font-bold uppercase leading-none md:text-4xl"
                  >
                    {t.about}
                  </h2>
                  <p class="mt-5 font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60">
                    {t.writtenBy}
                  </p>
                </div>
              );
            })
          }
        </div>

        <div class="min-w-0 md:border-l md:border-line md:pl-12 lg:pl-16">
          {
            LOCALES.map((lang) => {
              const t = manifestUi[lang];
              const about = aboutText[lang];
              return (
                <div data-lang={lang} lang={lang}>
                  <p data-fade class="max-w-3xl text-2xl leading-snug md:text-3xl">
                    {about.lead}
                  </p>

                  <dl data-reveal class="box-sm mt-10 grid max-w-3xl gap-y-4 p-6 md:grid-cols-[minmax(0,12rem)_minmax(0,1fr)] md:gap-x-6">
                    {about.facts.map((f) => (
                      <>
                        <dt class="font-mono text-[.68rem] uppercase tracking-[.12em] opacity-60">
                          {f.label}
                        </dt>
                        <dd>{f.value}</dd>
                      </>
                    ))}
                  </dl>

                  <div class="mt-12 grid max-w-3xl gap-8">
                    {about.paragraphs.map((p) => (
                      <section data-reveal>
                        <h3 class="font-mono text-[.72rem] font-normal uppercase tracking-[.12em] text-manifest">
                          {p.title}
                        </h3>
                        <p class="mt-3 leading-relaxed opacity-90">{p.text}</p>
                      </section>
                    ))}
                  </div>

                  <div data-reveal class="mt-12 max-w-3xl border-t border-line pt-6">
                    <p class="font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60">{t.cite}</p>
                    <p class="mt-3">{about.cite}</p>
                    <p class="mt-6">
                      <a
                        href={`mailto:${AUTHOR.contact}`}
                        class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                      >
                        {t.sendCorrection}
                      </a>
                    </p>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </Box>
  </div>

  <Footer />
</BaseLayout>

<script>
  import { initManifest } from "../scripts/manifest";

  let current: Element | null = null;
  let cleanup: (() => void) | null = null;

  const boot = () => {
    const root = document.querySelector("[data-manifest]");
    if (!root || root === current) return;
    cleanup?.();
    current = root;
    cleanup = initManifest();
  };

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
    current = null;
  });
</script>

<style is:global>
  /* ---- Initial state until the script sets data-ready (CSS fallback after 2.5s) ---- */
  [data-manifest]:not([data-ready]) :is([data-reveal], [data-split], [data-fade], .manifest-prose > *) {
    opacity: 0;
    animation: mf-show 0s linear 2.5s forwards;
  }
  [data-manifest]:not([data-ready]) [data-line] {
    transform: scaleX(0);
    animation: mf-show-line 0s linear 2.5s forwards;
  }
  @keyframes mf-show {
    to {
      opacity: 1;
    }
  }
  @keyframes mf-show-line {
    to {
      transform: none;
    }
  }

  /* ---- Language switch: long texts differ in length, so the inactive language
          is removed from the layout (no empty gaps), instead of just being hidden ---- */
  :root:not([lang="it"]) [data-manifest] [data-lang="it"],
  :root[lang="it"] [data-manifest] [data-lang="en"] {
    display: none !important;
  }

  /* ---- Prose: styles for the MDX body ---- */
  .manifest-prose {
    font-size: 1.0625rem;
    line-height: 1.75;
    overflow-wrap: break-word;
  }
  .manifest-prose > * + * {
    margin-top: 1.25rem;
  }
  .manifest-prose h3 {
    margin-top: 3.5rem;
    font-family: var(--font-bespoke, "Bespoke", sans-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .manifest-prose h3 + * {
    margin-top: 1.25rem;
  }
  .manifest-prose strong {
    font-weight: 700;
  }
  .manifest-prose em {
    opacity: 0.75;
  }
  .manifest-prose a {
    text-decoration: underline;
    text-decoration-color: var(--manifest);
    text-underline-offset: 0.25em;
    transition: color 0.2s ease;
  }
  .manifest-prose a:hover {
    color: var(--manifest);
  }
  .manifest-prose ul,
  .manifest-prose ol {
    list-style: none;
    padding: 0;
  }
  .manifest-prose li {
    position: relative;
    padding-left: 2rem;
  }
  .manifest-prose li + li {
    margin-top: 0.7rem;
  }
  .manifest-prose ul > li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--manifest);
  }
  .manifest-prose ol {
    counter-reset: mf-ol;
  }
  .manifest-prose ol > li {
    counter-increment: mf-ol;
  }
  .manifest-prose ol > li::before {
    content: counter(mf-ol, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: ui-monospace, monospace;
