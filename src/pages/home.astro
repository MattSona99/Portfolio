---
import BaseLayout from "../layouts/BaseLayout.astro";
import Box from "../components/ui/Box.astro";
import PageCard from "../components/home/PageCard.astro";
import HeroGame from "../components/home/HeroGame.astro";
import Footer from "../components/home/Footer.astro";
import { ui } from "../i18n/ui";

const cards = [
  {
    title: { en: ui.en.home.cards.github, it: ui.it.home.cards.github },
    href: "https://github.com/matttsona",
    accent: "github",
    external: true,
  },
  {
    title: { en: ui.en.home.cards.curriculum, it: ui.it.home.cards.curriculum },
    href: "/curriculum",
    accent: "curriculum",
  },
  {
    title: { en: ui.en.home.cards.manifest, it: ui.it.home.cards.manifest },
    href: "/manifest",
    accent: "manifest",
  },
] as const;
---

<BaseLayout>
  <Box
    as="section"
    data-hero
    aria-label="Hero"
    class="-mt-2px relative h-[calc(100svh-var(--header-h))] w-full overflow-hidden"
  >
    <HeroGame />
    <div
      data-hero-overlay
      class="pointer-events-none absolute inset-0 bg-bg/0 transition-colors duration-100"
    >
    </div>
  </Box>

  <section
    data-cards-section
    class="box-grid -mt-2px grid h-[100svh] w-full grid-cols-1 items-stretch pt-[var(--header-h)] md:grid-cols-3"
  >
    {cards.map((c) => <PageCard {...c} />)}
  </section>

  <Footer />
</BaseLayout>
