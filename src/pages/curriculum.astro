---
import BaseLayout from "../layouts/BaseLayout.astro";
import Box from "../components/ui/Box.astro";
import Footer from "../components/home/Footer.astro";
import { ui } from "../i18n/ui";

type Entry = { title: string; org?: string; meta?: string; notes?: string[] };
type Section = { label: string; text?: string; items?: (string | Entry)[] };

const langs = ["en", "it"] as const;

// Contatti: uguali in entrambe le lingue
const contact = [
  { label: "matteosonaglioni@proton.me", href: "mailto:matteosonaglioni@proton.me" },
  { label: "+39 339 178 6359", href: "tel:+393391786359" },
  { label: "github.com/matttsona", href: "https://github.com/matttsona", external: true },
];

const order = [
  "profile",
  "education",
  "international",
  "skills",
  "work",
  "languages",
  "interests",
] as const;
---

<BaseLayout>
  <div data-curriculum>
    {/* --- HERO SECTION --- */}
    <Box
      as="section"
      data-hero
      aria-label="Hero"
      class="-mt-2px relative h-[calc(100svh-var(--header-h))] w-full overflow-hidden"
    >
      <div data-hero-content class="grid grid-cols-1 grid-rows-1 h-full w-full">
        {
          langs.map((lang) => {
            const t = ui[lang].curriculum;
            return (
              <div
                data-lang={lang}
                lang={lang}
                class="col-start-1 row-start-1 flex h-full w-full flex-col justify-between p-6 md:p-12"
              >
                <div class="flex items-center gap-3 font-mono text-[.72rem] uppercase tracking-[.12em]">
                  {/* Pallino in alto a sinistra cambiato in verde #25a244 */}
                  <span class="inline-block size-2 bg-[#25a244]" aria-hidden="true" />
                  <span>{t.title}</span>
                </div>

                <div>
                  <h1
                    data-split
                    data-intro
                    class="font-bespoke text-[clamp(2.75rem,12vw,10rem)] font-extrabold uppercase leading-[.9]"
                  >
                    {t.name}
                  </h1>
                  <p
                    data-split
                    data-intro
                    class="mt-6 max-w-2xl font-mono text-xs uppercase leading-relaxed tracking-[.12em] opacity-75 md:text-sm"
                  >
                    {t.role}
                  </p>
                </div>

                <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
                  <ul class="flex flex-wrap gap-3">
                    {contact.map((c) => (
                      <li>
                        <a
                          href={c.href}
                          target={c.external ? "_blank" : undefined}
                          rel={c.external ? "noopener noreferrer" : undefined}
                          class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                        >
                          {c.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                  <p class="font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60 md:text-right">
                    {t.location}
                    <span class="mt-1 block">{t.scroll}</span>
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </Box>

    {/* --- SEZIONI CONTENUTO (STRUTTURA A CONTENITORI STABILI) --- */}
    {
      order.map((key) => {
        return (
          <Box as="section" class="-mt-px relative w-full">
            <div class="grid gap-8 p-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2.2fr)] md:gap-0 md:p-12">
              
              {/* TITOLI DI SEZIONE SOVRAPPOSTI */}
              <div class="grid grid-cols-1 grid-rows-1 self-start md:sticky md:top-[calc(var(--header-h)+2rem)] md:pr-10">
                {langs.map((lang) => {
                  const s = ui[lang].curriculum.sections[key] as Section;
                  return (
                    <h2
                      data-lang={lang}
                      lang={lang}
                      data-split
                      class="col-start-1 row-start-1 font-bespoke text-3xl font-bold uppercase leading-none md:text-4xl"
                    >
                      {s.label}
                    </h2>
                  );
                })}
              </div>

              {/* CONTENUTI DI SEZIONE SOVRAPPOSTI */}
              <div class="grid grid-cols-1 grid-rows-1 md:border-l md:border-line md:pl-12 lg:pl-16">
                {langs.map((lang) => {
                  const s = ui[lang].curriculum.sections[key] as Section;
                  return (
                    <div
                      data-lang={lang}
                      lang={lang}
                      class="col-start-1 row-start-1 w-full"
                    >
                      {s.text && (
                        <p data-fade class="max-w-3xl text-2xl leading-snug md:text-3xl">
                          {s.text}
                        </p>
                      )}

                      {s.items?.map((item, i) => (
                        <>
                          {i > 0 && (
                            <div
                              data-line
                              class="h-px w-full origin-left bg-line"
                              aria-hidden="true"
                            />
                          )}
                          {typeof item === "string" ? (
                            <p data-reveal class="py-4 font-bespoke text-xl font-bold md:text-2xl">
                              {item}
                            </p>
                          ) : (
                            <article
                              data-reveal
                              class="grid gap-x-8 gap-y-1 py-6 md:grid-cols-[minmax(0,1fr)_auto]"
                            >
                              <h3 class="font-bespoke text-2xl font-bold leading-tight md:text-3xl">
                                {item.title}
                              </h3>
                              {item.meta && (
                                <p class="font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60 md:pt-2 md:text-right">
                                  {item.meta}
                                </p>
                              )}
                              {item.org && <p class="opacity-70 md:col-span-2">{item.org}</p>}
                              {item.notes && (
                                <ul class="mt-3 grid gap-1 opacity-80 md:col-span-2">
                                  {item.notes.map((n) => (
                                    /* Trattini delle liste cambiati in verde #25a244 */
                                    <li class="before:mr-3 before:text-[#25a244] before:content-['—']">
                                      {n}
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </article>
                          )}
                        </>
                      ))}
                    </div>
                  );
                })}
              </div>

            </div>
          </Box>
        );
      })
    }

    {/* --- FOOTER GDPR --- */}
    <div class="grid grid-cols-1 grid-rows-1 w-full">
      {langs.map((lang) => {
        const t = ui[lang].curriculum;
        return (
          <p
            data-lang={lang}
            lang={lang}
            data-reveal
            class="col-start-1 row-start-1 max-w-3xl p-6 font-mono text-[.62rem] uppercase leading-relaxed tracking-[.12em] opacity-50 md:p-12"
          >
            {t.gdpr}
          </p>
        );
      })}
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  import { initCurriculum } from "../scripts/curriculum";

  let current: Element | null = null;
  let cleanup: (() => void) | null = null;

  const boot = () => {
    const root = document.querySelector("[data-curriculum]");
    if (!root || root === current) return;
    cleanup?.();
    current = root;
    cleanup = initCurriculum();
  };

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
    current = null;
  });
</script>

<style is:global>

  /* Stato iniziale finché lo script non ha impostato data-ready. */
  [data-curriculum]:not([data-ready]) :is([data-reveal], [data-split], [data-fade]) {
    opacity: 0;
    animation: cv-show 0s linear 2.5s forwards;
  }
  [data-curriculum]:not([data-ready]) [data-line] {
    transform: scaleX(0);
    animation: cv-show-line 0s linear 2.5s forwards;
  }
  @keyframes cv-show {
    to {
      opacity: 1;
    }
  }
  @keyframes cv-show-line {
    to {
      transform: none;
    }
  }
</style>