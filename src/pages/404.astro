---
import BaseLayout from "../layouts/BaseLayout.astro";
import Box from "../components/ui/Box.astro";
import Footer from "../components/home/Footer.astro";
import { ui } from "../i18n/ui";

const langs = ["en", "it"] as const;
---

<BaseLayout title="404 — Matteo Sonaglioni">
  <div data-notfound>
    <Box
      as="section"
      aria-label="404"
      class="-mt-2px relative h-[calc(100svh-var(--header-h))] w-full overflow-hidden"
    >
      <div class="flex h-full w-full flex-col gap-6 p-6 md:p-12">
        {/* --- ETICHETTA IN ALTO --- */}
        <div class="grid grid-cols-1 grid-rows-1">
          {
            langs.map((lang) => {
              const t = ui[lang].notFound;
              return (
                <div
                  data-lang={lang}
                  lang={lang}
                  class="col-start-1 row-start-1 flex items-center gap-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                >
                  <span
                    data-nf-blink
                    class="inline-block size-2 bg-[#25a244]"
                    aria-hidden="true"
                  />
                  <span>{t.label}</span>
                </div>
              );
            })
          }
        </div>

        {/* --- STAGE: 404 con il cubo al posto dello "0" ---
            La dimensione del font viene calcolata da scripts/404.ts
            per riempire tutto lo spazio disponibile. */}
        <div
          data-nf-stage
          class="relative flex min-h-0 flex-1 items-center justify-center"
        >
          <p
            data-nf-word
            aria-hidden="true"
            class="inline-flex shrink-0 select-none items-center gap-[.03em] font-bespoke text-[22vw] font-extrabold uppercase leading-[.9]"
          >
            <span class="inline-block overflow-hidden">
              <span data-nf-digit class="inline-block">4</span>
            </span>

            {/* Cubo isometrico con occhi sulla faccia destra.
                Altezza del cubo: regola h-[.8em] / w-[.8em]. */}
            <span data-nf-cube class="inline-block cursor-pointer">
              <svg
                data-nf-float
                viewBox="0 0 100 100"
                class="block h-[.8em] w-[.8em] overflow-visible"
                focusable="false"
              >
                <g stroke-linejoin="round" style="stroke:var(--bg);stroke-width:1.5">
                  <polygon
                    points="50,6 88,28 50,50 12,28"
                    style="fill:var(--fg)"
                  />
                  <polygon
                    points="12,28 50,50 50,94 12,72"
                    style="fill:var(--fg);fill-opacity:.55"
                  />
                  <polygon
                    points="50,50 88,28 88,72 50,94"
                    style="fill:var(--fg);fill-opacity:.78"
                  />
                </g>
                {/* Coordinate della faccia destra: u,v ∈ [0,1] */}
                <g transform="matrix(38 -22 0 44 50 50)">
                  <ellipse
                    data-nf-eye
                    cx=".3"
                    cy=".42"
                    rx=".1"
                    ry=".17"
                    style="fill:var(--bg)"
                  />
                  <ellipse
                    data-nf-eye
                    cx=".7"
                    cy=".42"
                    rx=".1"
                    ry=".17"
                    style="fill:var(--bg)"
                  />
                  <ellipse
                    data-nf-pupil
                    cx=".3"
                    cy=".42"
                    rx=".05"
                    ry=".085"
                    style="fill:var(--fg)"
                  />
                  <ellipse
                    data-nf-pupil
                    cx=".7"
                    cy=".42"
                    rx=".05"
                    ry=".085"
                    style="fill:var(--fg)"
                  />
                </g>
              </svg>
            </span>

            <span class="inline-block overflow-hidden">
              <span data-nf-digit class="inline-block">4</span>
            </span>
          </p>
        </div>

        <div
          data-nf-line
          class="h-px w-full origin-left bg-line"
          aria-hidden="true"
        >
        </div>

        {/* --- TESTO + LINK --- */}
        <div
          class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-12"
        >
          <div class="grid grid-cols-1 grid-rows-1">
            {
              langs.map((lang) => {
                const t = ui[lang].notFound;
                return (
                  <div
                    data-lang={lang}
                    lang={lang}
                    class="col-start-1 row-start-1 flex flex-col gap-3"
                  >
                    <h1
                      data-nf-in
                      class="font-bespoke text-2xl font-bold uppercase leading-none md:text-3xl"
                    >
                      {t.title}
                    </h1>
                    <p
                      data-nf-in
                      class="max-w-xl leading-snug opacity-75 md:text-lg"
                    >
                      {t.text}
                    </p>
                    <p
                      data-nf-in
                      class="break-all font-mono text-[.72rem] uppercase tracking-[.12em] opacity-60"
                    >
                      {t.requested}: <span data-nf-path>/</span>
                    </p>
                  </div>
                );
              })
            }
          </div>

          <div class="grid grid-cols-1 grid-rows-1">
            {
              langs.map((lang) => {
                const t = ui[lang].notFound;
                const c = ui[lang].home.cards;
                return (
                  <div
                    data-nf-in
                    data-lang={lang}
                    lang={lang}
                    class="col-start-1 row-start-1 flex flex-wrap items-center gap-3"
                  >
                    <a
                      href="/home"
                      class="sheen sheen-contrast box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                    >
                      ← {t.home}
                    </a>
                    <a
                      href="/curriculum"
                      class="sheen box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                    >
                      {c.curriculum}
                    </a>
                    <a
                      href="/manifest"
                      class="sheen box-sm inline-block px-4 py-3 font-mono text-[.72rem] uppercase tracking-[.12em]"
                    >
                      {c.manifest}
                    </a>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </Box>
  </div>

  <Footer />
</BaseLayout>

<script>
  import { initNotFound } from "../scripts/404";

  let current: Element | null = null;
  let cleanup: (() => void) | null = null;

  const boot = () => {
    const root = document.querySelector("[data-notfound]");
    if (!root || root === current) return;
    cleanup?.();
    current = root;
    cleanup = initNotFound() ?? null;
  };

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
    current = null;
  });
</script>

<style is:global>
  /* Stato iniziale finché lo script non ha impostato data-ready.
     Solo opacity: niente transform in CSS, altrimenti GSAP la legge come
     offset in px e le animazioni yPercent restano spostate.
     Fallback: dopo 2.5s tutto diventa comunque visibile. */
  [data-notfound]:not([data-ready])
    :is([data-nf-in], [data-nf-digit], [data-nf-cube], [data-nf-line]) {
    opacity: 0;
    animation: nf-show 0s linear 2.5s forwards;
  }
  @keyframes nf-show {
    to {
      opacity: 1;
    }
  }

  /* Quadratino verde che lampeggia come un cursore */
  [data-nf-blink] {
    animation: nf-blink 1.1s steps(1, end) infinite;
  }
  @keyframes nf-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-nf-blink] {
      animation: none;
    }
  }
</style>