<div data-hero-game class="hero-game absolute inset-0 overflow-hidden" tabindex="0" aria-label="Gioco isometrico: usa le frecce per muovere il cubo.">
  <canvas data-hero-canvas class="block h-full w-full"></canvas>
</div>
<script>
  import { mountHeroGame } from '../../scripts/hero-game';
  
  // Avvolgiamo in page-load così si ricarica se torni alla home
  document.addEventListener('astro:page-load', () => {
    const shell = document.querySelector<HTMLElement>('[data-hero-game]');
    if (shell) {
      const destroy = mountHeroGame(shell);
      
      // IMPORTANTE: usiamo 'astro:before-preparation' al posto di 'astro:before-swap'.
      // Questo elimina il canvas dell'esplosione PRIMA che Astro faccia lo "screenshot" per la transizione.
      document.addEventListener('astro:before-preparation', destroy, { once: true });
    }
  });
</script>
<style>
  .hero-game { background: var(--bg); outline: none; }
  .hero-game canvas { display: block; }
</style>
