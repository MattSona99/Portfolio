---
import Box from "../ui/Box.astro";
import githubImg from "../../assets/cards/github.png";
import curriculumImg from "../../assets/cards/curriculum.png";
import manifestImg from "../../assets/cards/manifest.png";

type TitleProp = string | { en: string; it: string };

interface Props {
  title: TitleProp;
  href: string;
  accent: "github" | "curriculum" | "manifest";
  external?: boolean;
}
const { title, href, accent, external = false } = Astro.props;

const patternMap = {
  github: githubImg.src,
  curriculum: curriculumImg.src,
  manifest: manifestImg.src,
};

const langs = ["en", "it"] as const;
const titles = typeof title === "string" ? { en: title, it: title } : title;
---

<Box
  as="a"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  data-card
  data-card-type={accent}
  style={`--accent: var(--${accent})`}
  class="group relative flex h-full min-h-0 flex-col overflow-hidden bg-bg select-none"
>
  {/* --- BARRA SUPERIORE (Titolo animato) --- */}
  <div
    class="relative z-20 grid h-14 shrink-0 place-items-center border-b border-line bg-bg px-4"
  >
    <div
      data-card-title
      class="relative grid grid-cols-1 grid-rows-1 overflow-hidden font-bespoke text-sm font-bold tracking-[0.22em] uppercase leading-none py-1 md:text-base"
    >
      {
        langs.map((lang) => {
          const text = titles[lang];
          const chars = text.split("");
          return (
            <div
              data-lang={lang}
              lang={lang}
              class="col-start-1 row-start-1 relative overflow-hidden"
            >
              {/* Riga 1: Lettere standard */}
              <div class="flex justify-center">
                {chars.map((char) => (
                  <span data-char-top class="inline-block will-change-transform">
                    {char === " " ? "\u00A0" : char}
                  </span>
                ))}
              </div>

              {/* Riga 2: Lettere colorate (senza py-1 per combaciare perfettamente con Riga 1) */}
              <div
                class="pointer-events-none absolute inset-0 flex justify-center text-[var(--accent)]"
                aria-hidden="true"
              >
                {chars.map((char) => (
                  <span data-char-bottom class="inline-block will-change-transform">
                    {char === " " ? "\u00A0" : char}
                  </span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>

  {/* --- CORPO DELLA CARD --- */}
  <div
    class="relative grid min-h-0 flex-1 place-items-center overflow-hidden p-6"
  >
    {/* 1. PATTERN VETTORIALE RIPETUTO */}
    <div
      data-card-pattern
      class="pointer-events-none absolute inset-0 z-0 opacity-[0.50] invert dark:invert-0 will-change-transform"
      style={`
        background-image: url('${patternMap[accent]}');
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        mix-blend-mode: luminosity;
      `}
    >
    </div>

    {/* 2. Sipario di sfondo che sale in hover */}
    <div
      data-card-bg
      class="pointer-events-none absolute inset-0 z-0 origin-bottom scale-y-0 bg-[var(--accent)] opacity-[0.08] mix-blend-overlay will-change-transform"
    >
    </div>

    {/* 3. Kinetic Typography Stack Centrato */}
    <div
      class="pointer-events-none relative grid grid-cols-1 grid-rows-1 place-items-center text-center w-full"
    >
      {
        langs.map((lang) => {
          const text = titles[lang];
          const chars = text.split("");
          return (
            <div
              data-lang={lang}
              lang={lang}
              class="col-start-1 row-start-1 grid place-items-center w-full"
            >
              {/* Eco Superiore (Outline) */}
              <span
                data-center-echo-top
                class="col-start-1 row-start-1 font-bespoke text-3xl font-extrabold tracking-tight uppercase opacity-0 will-change-transform sm:text-4xl lg:text-5xl"
                style="-webkit-text-stroke: 1px var(--accent); color: transparent;"
                aria-hidden="true"
              >
                {text}
              </span>

              {/* Eco Inferiore (Outline) */}
              <span
                data-center-echo-bottom
                class="col-start-1 row-start-1 font-bespoke text-3xl font-extrabold tracking-tight uppercase opacity-0 will-change-transform sm:text-4xl lg:text-5xl"
                style="-webkit-text-stroke: 1px var(--accent); color: transparent;"
                aria-hidden="true"
              >
                {text}
              </span>

              {/* Scritta Centrale Principale */}
              <div
                data-center-main
                class="col-start-1 row-start-1 flex justify-center font-bespoke text-3xl font-extrabold tracking-tight uppercase opacity-15 will-change-transform sm:text-4xl lg:text-5xl"
              >
                {chars.map((char) => (
                  <span data-center-char class="inline-block will-change-transform">
                    {char === " " ? "\u00A0" : char}
                  </span>
                ))}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</Box>