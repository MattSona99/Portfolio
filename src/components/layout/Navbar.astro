---
import Box from "../ui/Box.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import LangToggle from "../ui/LangToggle.astro";

// Determina il colore iniziale lato server
const { pathname } = Astro.url;

let sColor = "var(--home, #25a244)";
if (pathname.startsWith("/curriculum")) {
  sColor = "var(--curriculum)";
} else if (pathname.startsWith("/manifest")) {
  sColor = "var(--manifest)";
}
---

<header transition:persist="navbar" data-site-navbar class="sticky top-0 z-50 bg-bg">
  <div data-nav-shell class="nav-shell">
    <Box
      as="nav"
      aria-label="Principale"
      class="grid h-16 grid-cols-[1fr_auto_1fr] items-center px-4 md:px-6"
    >
      <!-- SLOTS SINISTRA: Tasto Indietro -->
      <div class="flex items-center justify-start">
        <button
          type="button"
          data-back-btn
          aria-label="Torna indietro"
          class="box-sm sheen sheen-contrast grid size-9 place-items-center transition-all duration-300 hover:scale-105 active:scale-95 opacity-0 -translate-x-4 pointer-events-none"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
        </button>
      </div>

      <!-- CENTRO: Logo -->
      <a
        href="/home"
        class="flex justify-center font-bespoke text-2xl font-extrabold tracking-[0.2em] md:text-4xl"
      >
        M<span data-logo-s style={`color: ${sColor}; transition: color 0.3s ease;`}>S</span>
      </a>

      <!-- SLOTS DESTRA: Toggles -->
      <div class="flex items-center justify-end gap-2">
        <LangToggle />
        <ThemeToggle />
      </div>
    </Box>
  </div>
</header>

<script>
  function updateSColor() {
    const sElement = document.querySelector<HTMLElement>('[data-logo-s]');
    if (!sElement) return;

    const path = window.location.pathname;

    if (path.startsWith('/curriculum')) {
      sElement.style.color = 'var(--curriculum)';
    } else if (path.startsWith('/manifest')) {
      sElement.style.color = 'var(--manifest)';
    } else {
      sElement.style.color = 'var(--home, #25a244)';
    }
  }

  // Si attiva ad ogni cambio di pagina con View Transitions
  document.addEventListener('astro:page-load', updateSColor);
</script>

<style>
  .nav-shell {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    will-change: max-width, padding;
  }

  @media (min-width: 48rem) {
    .nav-shell {
      padding-inline: 2.5rem;
    }
  }
</style>