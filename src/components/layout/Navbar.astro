---
import Box from "../ui/Box.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import LangToggle from "../ui/LangToggle.astro";
---

<header transition:persist="navbar" data-site-navbar class="sticky top-0 z-50 bg-bg">
  <div data-nav-shell class="nav-shell">
    <Box
      as="nav"
      aria-label="Principale"
      class="grid h-16 grid-cols-[1fr_auto] items-center px-4 md:grid-cols-[1fr_auto_1fr] md:px-6"
    >
      <span class="hidden md:block" aria-hidden="true"></span>

      <a
        href="/home"
        class="font-bespoke text-2xl font-extrabold tracking-[0.2em] md:text-4xl"
      >
        M<span style="color: #25a244;">S</span>
      </a>

      <div class="flex items-center justify-end gap-2">
        <LangToggle />
        <ThemeToggle />
      </div>
    </Box>
  </div>
</header>

<style>
  .nav-shell {
    width: 100%;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    will-change: max-width, padding;
  }

  @media (min-width: 48rem) {
    .nav-shell {
      padding-inline: 2.5rem;
    }
  }
</style>